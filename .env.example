# Copy to .env.local for local dev with `vercel dev`.
# In production, set these in Vercel: Project -> Settings -> Environment Variables.
# Get these free by registering an app at https://developer.kroger.com

KROGER_CLIENT_ID=your_client_id_here
KROGER_CLIENT_SECRET=your_client_secret_here

# Optional: set to "true" to serve fixture data from api/_mock-data.js
# instead of calling Kroger, so you can test the UI (including error/empty
# states) without real credentials. Leave unset or "false" for real data.
# Special ZIPs in mock mode: 00000 = no stores found, 99999 = provider failure.
# NEVER set this to "true" in a production/Vercel environment.
USE_MOCK_DATA=false

# Optional tuning — all have conservative built-in defaults (see README
# "Configuration"). Leave unset unless real Vercel timing data justifies
# a change; raising these without measuring first risks function timeouts.
# DEALS_MAX_STORES=5
# DEALS_CONCURRENCY=6
# DEALS_DEADLINE_MS=7000
# BASKET_MAX_STORES=3
# BASKET_MAX_ITEMS=6
# BASKET_CONCURRENCY=6
# BASKET_DEADLINE_MS=7000
